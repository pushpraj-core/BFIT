<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BFIT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- BFIT Brand Colors -->
        <item name="colorPrimary">@color/bfit_primary</item>
        <item name="colorPrimaryContainer">@color/bfit_primary_container</item>
        <item name="colorSecondary">@color/bfit_secondary</item>
        <item name="colorSecondaryContainer">@color/bfit_secondary_container</item>

        <!-- Surface tones -->
        <item name="colorSurface">#F8FAFF</item>
        <item name="colorSurfaceVariant">#F0F0F8</item>
        <item name="colorSurfaceContainer">#EAEAF5</item>
        <item name="colorSurfaceContainerHighest">#E0E0ED</item>
        <item name="colorOnSurface">@color/bfit_on_surface</item>

        <!-- Smooth Activity Transition Animations -->
        <item name="android:windowAnimationStyle">@style/BFITWindowAnimations</item>
    </style>

    <style name="Theme.BFIT" parent="Base.Theme.BFIT" />

    <!-- Premium card with generous rounding and depth -->
    <style name="Widget.BFIT.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <!-- Glass-style card for overlays and special sections -->
    <style name="Widget.BFIT.Card.Glass" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- Primary action button — rounded, solid -->
    <style name="Widget.BFIT.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Pill button for secondary actions -->
    <style name="Widget.BFIT.PillButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Activity transition animations -->
    <style name="BFITWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Splash Screen Theme (Android 12+ SplashScreen API) -->
    <style name="Theme.BFIT.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bfit_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_bfit_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.BFIT</item>
    </style>
</resources>