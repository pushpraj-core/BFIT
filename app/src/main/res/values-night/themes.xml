<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BFIT" parent="Theme.Material3.Dark.NoActionBar">
        <!-- BFIT Brand Colors (Dark Mode) -->
        <item name="colorPrimary">@color/bfit_primary</item>
        <item name="colorPrimaryContainer">@color/bfit_primary_container</item>
        <item name="colorSecondary">@color/bfit_secondary</item>
        <item name="colorSecondaryContainer">@color/bfit_secondary_container</item>

        <!-- Deep midnight surfaces -->
        <item name="colorSurface">#080B14</item>
        <item name="colorSurfaceVariant">#0D1117</item>
        <item name="colorSurfaceContainer">#131720</item>
        <item name="colorSurfaceContainerHighest">#1A1F2E</item>
        <item name="colorOnSurface">#F1F5F9</item>

        <!-- Smooth Activity Transition Animations -->
        <item name="android:windowAnimationStyle">@style/BFITWindowAnimations</item>
    </style>
</resources>